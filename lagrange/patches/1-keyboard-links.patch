+/* isoPod: with only a D-pad, Up and Down move from link to link, as on a TV. A link cut off
+   at the edge is scrolled into sight; with no link in sight that way, the page scrolls a few
+   lines as the arrow keys usually do. Return opens the link as a click does. */
+static iBool isLinkLine_GmRun_(const iGmRun *run) {
+    return run->linkId && !isMedia_GmRun(run); /* not a picture shown under its link */
+}
+
+static void moveKeyFocus_DocumentWidget_(iDocumentWidget *d, int dir) {
+    iDocumentView  *view    = d->view;
+    const iRangei   vis     = visibleRange_DocumentView(view);
+    const iGmLinkId current = view->keyFocusLink;
+    iGmLinkId       target  = 0;
+    iRangei         span    = { 0, 0 };
+    iBool           passed  = (current == 0);
+    const size_t    count   = size_PtrArray(&view->visibleLinks);
+    for (size_t n = 0; n < count; n++) {
+        const iGmRun *run = constAt_PtrArray(&view->visibleLinks, dir > 0 ? n : count - 1 - n);
+        if (!isLinkLine_GmRun_(run)) {
+            continue;
+        }
+        const int top    = run->visBounds.pos.y;
+        const int bottom = top + run->visBounds.size.y;
+        if (target) {
+            if (run->linkId != target) {
+                break;
+            }
+            span.start = iMin(span.start, top);
+            span.end   = iMax(span.end, bottom);
+            continue;
+        }
+        if (run->linkId == current) {
+            passed = iTrue;
+            continue;
+        }
+        if (!passed || (!current && (dir > 0 ? top < vis.start : bottom > vis.end))) {
+            continue; /* before the focus, or cut off where we come from */
+        }
+        target = run->linkId;
+        span   = (iRangei){ top, bottom };
+    }
+    const int duration = smoothDuration_DocumentWidget_(keyboard_ScrollType);
+    if (!target) {
+        smoothScroll_DocumentView(view, dir * 3 * lineHeight_Text(paragraph_FontId), duration);
+        return;
+    }
+    const int margin = lineHeight_Text(paragraph_FontId) / 2;
+    view->keyFocusLink = target;
+    if (span.end > vis.end) {
+        smoothScroll_DocumentView(view, span.end - vis.end + margin, duration);
+    }
+    else if (span.start < vis.start) {
+        smoothScroll_DocumentView(view, span.start - vis.start - margin, duration);
+    }
+    updateHover_DocumentView(view, zero_I2());
+}
+
+/* The focused link's text in sight, where a click opens it. */
+static const iGmRun *keyFocusRun_DocumentWidget_(const iDocumentWidget *d) {
+    const iGmRun *found = NULL;
+    iConstForEach(PtrArray, i, &d->view->visibleLinks) {
+        const iGmRun *run = i.ptr;
+        if (d->view->keyFocusLink && run->linkId == d->view->keyFocusLink && isLinkLine_GmRun_(run)) {
+            found = run;
+            if (~run->flags & decoration_GmRunFlag) {
+                break;
+            }
+        }
+    }
+    return found;
+}
